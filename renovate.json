{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["github-actions", "gomod", "npm"],
  "dependencyDashboard": true,
  "labels": ["dependencies"],
  "platformAutomerge": false,
  "prHourlyLimit": 0,
  "prConcurrentLimit": 10,
  "rebaseWhen": "conflicted",
  "rangeStrategy": "bump",
  "timezone": "Europe/Rome",
  "ignoreDeps": ["node"],
  "packageRules": [
    {
      "description": "Delay npm updates for pnpm minimum release age",
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "1 day"
    },
    {
      "description": "Group frontend runtime updates",
      "matchManagers": ["npm"],
      "matchPackageNames": ["/^react$/", "/^react-dom$/", "/^@xterm\\//"],
      "groupName": "frontend-runtime",
      "groupSlug": "frontend-runtime"
    },
    {
      "description": "Group frontend tooling updates",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "/^@vitejs\\//",
        "/^vite$/",
        "/^vitest$/",
        "/^@playwright\\//"
      ],
      "groupName": "frontend-tooling",
      "groupSlug": "frontend-tooling"
    },
    {
      "description": "Group server Go module updates",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["require"],
      "groupName": "server-runtime",
      "groupSlug": "server-runtime"
    },
    {
      "description": "Tidy Go modules after updates",
      "matchManagers": ["gomod"],
      "postUpdateOptions": ["gomodTidy"]
    },
    {
      "description": "Group QA tooling updates",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "/^@biomejs\\//",
        "/^typescript$/",
        "/^tsx$/",
        "/^concurrently$/",
        "/^zod$/",
        "/^ws$/"
      ],
      "groupName": "qa-tooling",
      "groupSlug": "qa-tooling"
    },
    {
      "description": "Automerge non-major updates after checks pass",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true,
      "automergeType": "pr"
    }
  ]
}
