{
  "name": "@icoretech/wootty-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite --config config/build/vite.config.ts",
    "build": "tsc -p tsconfig.json --noEmit && vite build --config config/build/vite.config.ts",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run --config config/test/vitest.config.ts",
    "test:e2e": "pnpm --dir ../.. build && env -u NO_COLOR playwright test --config config/e2e/playwright.config.ts",
    "test:e2e:cross": "pnpm --dir ../.. build && WOOTTY_E2E_CROSS=1 env -u NO_COLOR playwright test --config config/e2e/playwright.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:contracts": "tsc -p tsconfig.contract-tests.json --noEmit"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24"
  }
}
