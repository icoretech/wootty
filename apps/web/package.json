{
  "name": "@icoretech/wootty-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run --config config/test/vitest.config.ts",
    "test:e2e": "pnpm --dir ../.. build && env -u NO_COLOR playwright test --config config/e2e/playwright.config.ts",
    "test:e2e:prebuilt": "WOOTTY_E2E_PREBUILT=1 env -u NO_COLOR playwright test --config config/e2e/playwright.config.ts",
    "test:e2e:cross": "pnpm --dir ../.. build && WOOTTY_E2E_CROSS=1 env -u NO_COLOR playwright test --config config/e2e/playwright.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:contracts": "tsc -p tsconfig.contract-tests.json --noEmit",
    "typecheck:config": "tsc -p tsconfig.config.json --noEmit"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@babel/core": "8.0.10",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "0.2.4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=26"
  }
}
