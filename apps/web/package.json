{
  "name": "@icoretech/wootty-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite --config config/build/vite.config.ts",
    "build": "tsc -p tsconfig.json --noEmit && vite build --config config/build/vite.config.ts",
    "test": "vitest run --config config/test/vitest.config.ts",
    "test:e2e": "pnpm --dir ../.. build && playwright test --config config/e2e/playwright.config.ts",
    "test:e2e:cross": "pnpm --dir ../.. build && WOOTTY_E2E_CROSS=1 playwright test --config config/e2e/playwright.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^0.575.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "^28.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=24"
  }
}
