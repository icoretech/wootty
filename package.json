{
  "name": "wootty",
  "private": true,
  "version": "0.2.8",
  "description": "WooTTY: modern web terminal with resilient PTY sessions",
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm --filter @icoretech/wootty-web build && cd apps/server && go build ./...",
    "ci": "pnpm lint && git diff --exit-code && pnpm test && pnpm build && pnpm test:e2e",
    "ci:act:quality": "act pull_request -j quality",
    "ci:act": "act pull_request -j e2e",
    "format": "biome format --write .",
    "format:check": "biome format --no-write .",
    "lint": "biome check --write --assist-enabled=true . && pnpm verify:docs-paths && pnpm verify:governance && pnpm typecheck",
    "check": "biome check .",
    "biome:ci": "biome ci .",
    "generate:terminal-contracts": "node scripts/generate-terminal-contract-bindings.mjs",
    "generate:governance": "node scripts/generate-terminal-governance-docs.mjs",
    "verify:docs-paths": "node scripts/verify-readme-paths.mjs",
    "verify:governance": "node scripts/generate-terminal-governance-docs.mjs --check",
    "test": "pnpm --filter @icoretech/wootty-web test && cd apps/server && go test ./...",
    "test:e2e": "pnpm --filter @icoretech/wootty-web test:e2e",
    "test:e2e:cross": "pnpm --filter @icoretech/wootty-web test:e2e:cross",
    "typecheck": "pnpm --filter @icoretech/wootty-web typecheck && pnpm --filter @icoretech/wootty-web typecheck:contracts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.2",
    "concurrently": "^9.2.1"
  }
}
